# Aplikasi
APP_ENV=prod                          # dev | staging | prod
HTTP_ADDR=:8080                      # Alamat server Go

# Database (Supabase / PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
TEST_DATABASE_URL=postgresql://user:password@host:5432/dbname_test?sslmode=require

# Auth 
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Cookie 
COOKIE_INSECURE_DEV=true

# Proxy
TRUSTED_PROXIES=127.0.0.1
ALLOWED_ORIGIN=http://localhost:3000

# Redis (Upstash — opsional di dev)
UPSTASH_REDIS_URL=
REDIS_DAILY_BUDGET=14000

# Storage
STORAGE_DRIVER=local                 # local | supabase
STORAGE_LOCAL_DIR=.data/storage

# Supabase Storage (staging/prod)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# AI (opsional di dev — FakeLLM dipakai bila kosong)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Migrasi otomatis saat start (dev only)
AUTO_MIGRATE=true

